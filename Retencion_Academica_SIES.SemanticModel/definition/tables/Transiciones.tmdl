	partition Transiciones = m
		mode: import
		source =
				let
					Files = Folder.Files(#"Ruta datos"),
					Selected = Table.SelectRows(Files, each Text.StartsWith([Name], "transiciones_") and Text.EndsWith([Name], ".csv.gz")),
					Parsed = Table.AddColumn(Selected, "Rows", each Table.PromoteHeaders(Csv.Document(Binary.Decompress([Content], Compression.GZip), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])),
					Combined = Table.Combine(Parsed[Rows]),
					Types = Table.TransformColumnTypes(Combined,{{"MRUN",type text},{"AnioOrigen",Int64.Type},{"AnioDestino",Int64.Type},{"TieneOrigen",Int64.Type},{"TieneDestino",Int64.Type},{"MismaCarreraExacta",Int64.Type},{"MismaInstitucionLegal",Int64.Type},{"OrigenIPLACEX",Int64.Type},{"DestinoIPLACEX",Int64.Type},{"OrigenECS",Int64.Type},{"DestinoECS",Int64.Type},{"InstitucionOrigenID",type text},{"InstitucionOrigen",type text},{"TipoInstitucionOrigen",type text},{"CarreraExactaOrigenID",type text},{"CodigoCarreraOrigen",type text},{"CarreraOrigen",type text},{"NivelOrigen",type text},{"AreaCarreraGenericaOrigen",type text},{"AreaConocimientoOrigen",type text},{"ModalidadOrigen",type text},{"JornadaOrigen",type text},{"InstitucionDestinoID",type text},{"InstitucionDestino",type text},{"TipoInstitucionDestino",type text},{"CarreraExactaDestinoID",type text},{"CodigoCarreraDestino",type text},{"CarreraDestino",type text},{"NivelDestino",type text},{"AreaCarreraGenericaDestino",type text},{"AreaConocimientoDestino",type text},{"ModalidadDestino",type text},{"JornadaDestino",type text},{"EstadoCarrera",type text},{"EstadoInstitucion",type text},{"EstadoEducacionSuperior",type text},{"TituladoPersonaAcumulado",Int64.Type}},"en-US")
				in Types

