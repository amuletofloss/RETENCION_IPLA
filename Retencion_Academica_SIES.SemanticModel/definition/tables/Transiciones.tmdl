table Transiciones
	lineageTag: db91d520-f1df-4aac-94d7-08b93fbf8ef1

	measure 'Personas flujo' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte])
			RETURN IF(_contextoValido,DISTINCTCOUNT('Transiciones'[MRUN]))
		formatString: #,##0
		displayFolder: Flujos anuales por personas
		lineageTag: 3fec3a64-4169-4342-99e5-bb0a5551bb99

	measure 'Personas cambio carrera misma IES' =
			VAR _contextoValido=HASONEVALUE('Cohortes'[Cohorte])
			RETURN IF(_contextoValido,CALCULATE(DISTINCTCOUNT('Transiciones'[MRUN]),'Transiciones'[TieneOrigen]=1,'Transiciones'[TieneDestino]=1,'Transiciones'[MismaInstitucionLegal]=1,'Transiciones'[MismaCarreraExacta]=0))
		formatString: #,##0
		displayFolder: Flujos anuales por personas
		lineageTag: b540847c-0eb1-488c-b09a-deaa5ae9ee88

