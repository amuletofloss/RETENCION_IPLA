table DimInstitucion
	lineageTag: 0b06876b-d595-4219-9fb1-531188df0ff7

	column InstitucionID
		dataType: string
		isHidden
		lineageTag: 407ecc3a-67ce-4a69-86f0-8bb1063799c9
		summarizeBy: none
		sourceColumn: InstitucionID

	column Institucion
		dataType: string
